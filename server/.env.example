# Asaas API Configuration
# Sandbox: https://sandbox.asaas.com/api/v3
# Producao: https://api.asaas.com/v3
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=sua_chave_api_aqui

# Token do webhook Asaas (header asaas-access-token). Se vazio, o webhook aceita qualquer origem.
ASAAS_WEBHOOK_TOKEN=
# Timeout (ms) das chamadas à Asaas
ASAAS_TIMEOUT_MS=10000
# Origens permitidas no CORS (CSV). Vazio = libera tudo (apenas dev).
# Ex.: ALLOWED_ORIGINS=https://simplificatributo.com.br,https://www.simplificatributo.com.br
ALLOWED_ORIGINS=

# Server
PORT=3001
